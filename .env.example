# Soldiers Training — variáveis de ambiente
# Copie para `.env` (local) ou configure no painel do Lovable / host.
# Nunca commite secrets. Nunca use prefixo VITE_ para chaves de LLM (exporia no client).

# --- Coach LLM (server-only) ---
# Sem esta chave, o coach usa o motor de regras local (modo offline).
OPENAI_API_KEY=

# Opcional — Claude não está no seletor da UI nesta fase; o provider fixo é chatgpt.
# ANTHROPIC_API_KEY=

# --- Supabase ---
# Client (anon / publishable)
# VITE_SUPABASE_URL=
# VITE_SUPABASE_PUBLISHABLE_KEY=
# Server (webhook, entitlements, admin DB — never VITE_)
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=

# --- Shopify access gate (server-only — never VITE_) ---
# Custom App com scopes read_orders (+ read_customers). write_orders se quiser stamp do note_attribute.
# Qualquer pedido pago no e-mail, nos últimos 40 dias, libera o app.
# Sem compra recente a conta existe, mas o treino fica em “compre para se manter ativo”.
SHOPIFY_STORE_DOMAIN=sua-loja.myshopify.com
SHOPIFY_ADMIN_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2025-01
# Webhook orders/paid → POST /api/shopify/webhook (HMAC)
SHOPIFY_WEBHOOK_SECRET=
# URL pública do app (magic links)
APP_ORIGIN=https://seu-app.lovable.app
# Storefront API (aba Loja / preços) — token Storefront, não Admin
SHOPIFY_STOREFRONT_TOKEN=
# Opcional: URL da loja no CTA + cupom de reposição + SKU Performance
# VITE_SHOPIFY_STOREFRONT_URL=https://soldiersnutrition.com.br
# VITE_SHOPIFY_REORDER_DISCOUNT=COMPANION10
# VITE_PERFORMANCE_PRODUCT_HANDLE=striker-pre-treino

# --- Access session (server-only — never VITE_) ---
# Required in production. Never reuse SHOPIFY_WEBHOOK_SECRET or API keys.
ACCESS_SESSION_SECRET=
# Local only: allow insecure fallback when ACCESS_SESSION_SECRET is unset
# ALLOW_INSECURE_DEV_SECRETS=true

# --- Coach rate limits (optional) ---
# COACH_RPM=10
# COACH_RPD=100

# --- Soldiers Media image-to-video (server/scripts only — never VITE_) ---
# Optional. Without it, motion uses Soldiers start/end stills (pose-end.webp).
# FAL_KEY=
# RUNWAY_API_KEY=
# KLING_API_KEY=

# --- Web Push (server-only private key; public key is returned by getVapidPublicKey) ---
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:privacy@soldiersnutrition.com.br
# Hourly cron: POST /api/cron/daily-pushes with Authorization: Bearer $CRON_SECRET
# CRON_SECRET=
# Backoffice /admin: e-mail + senha (ADMIN_PASSWORD). ADMIN_PIN ainda vale como senha.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# ADMIN_PIN=
